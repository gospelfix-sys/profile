#!/usr/bin/env sh
# .husky/pre-commit (sh 호환)
. "$(dirname -- "$0")/_/husky.sh"

# 스테이징된 파일에 frontend/ 또는 admin/ 변화가 있으면 해당 앱만 빌드
CHANGED=0

if git diff --cached --name-only | grep -q '^frontend/'; then
  echo "🔨 frontend/ 변경 감지 → build 실행"
  yarn --cwd frontend install --frozen-lockfile || exit 1
  yarn --cwd frontend build || exit 1
  CHANGED=1
fi

if git diff --cached --name-only | grep -q '^admin/'; then
  echo "🔨 admin/ 변경 감지 → build 실행"
  # admin/yarn.lock이 아직 없어 --frozen-lockfile을 쓰면 매번 실패한다 (docs/TECH-STACK-PRIORITY.md 참고)
  yarn --cwd admin install || exit 1
  yarn --cwd admin build || exit 1
  CHANGED=1
fi

if [ "$CHANGED" -eq 0 ]; then
  echo "ℹ️ frontend/admin 변경 없음 → build 스킵"
fi

# 기존 작업 유지
npx lint-staged || exit 1
